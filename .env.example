# --- Tomar AI System — environment example ---
# Copy to .env and fill in real values:  cp .env.example .env

# Google Gemini API key — get it from https://ai.google.dev
# Frontend (Vite) reads GEMINI_API_KEY; backend/legacy code reads API_KEY. Set both the same.
API_KEY=your_gemini_key_here
GEMINI_API_KEY=your_gemini_key_here

# MongoDB connection string.
# - Without Docker: your own local/Atlas URI, e.g. mongodb://localhost:27017
# - With docker compose: this is overridden to mongodb://mongo:27017 automatically.
MONGO_URI=mongodb://localhost:27017
